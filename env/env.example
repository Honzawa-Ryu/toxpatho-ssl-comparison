# scripts/slurm_entry.sh がジョブ起動時に source する環境変数のひな形。
# 実体の .env はリポジトリルートに置く（.gitignore 対象なのでコミットされない）。
# `make setup` がこのファイルをコピーして .env を作る。

# ノードローカルSSDのルート。
# 未定義なら slurm_entry.sh は /scratch/${USER} を使う。
# 実験ごとの作業ディレクトリは ${LOCAL_SSD_DIR}/${EXP_NAME}_${JOB_ID}/ に切られる。
LOCAL_SSD_DIR=/scratch/$USER

# Apptainer イメージ。未定義なら ${PROJECT_ROOT}/env/env.sif が使われる。
# SIF_PATH=/workspace/filesrv02/honzawa/wsi-ad/env/env.sif

# ジョブの開始/終了/失敗を Slack へ通知する（未設定なら通知はすべて no-op）。
# Slack の Incoming Webhook で取得した URL を入れる。
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ

# 通知の抑制（既定はすべて1＝通知する）
# SLACK_NOTIFY_ON_START=1
# SLACK_NOTIFY_ON_FINISH=1
# SLACK_NOTIFY_ON_FAIL=1

# 計算ノードから wandb へ直接送らない（既定 offline）。あとで `wandb sync` する前提。
WANDB_MODE=offline

# DataLoader worker が全コアを掴んで拮抗するのを防ぐ（REFACTOR_PLAN.md §1-1）。
# 1 以外にすると augmentation が大幅に遅くなるので、変更しないこと。
OMP_NUM_THREADS=1
